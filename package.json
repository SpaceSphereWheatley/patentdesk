{
  "name": "patentdesk",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint PatentDesk.html",
    "lint:html": "eslint --no-eslintrc -c .eslintrc-html.json PatentDesk.html",
    "test": "node --test test/*.test.js",
    "test:quiet": "node --test --test-reporter=dot test/*.test.js",
    "coverage:functions": "node test/functionCoverage.js",
    "codemap": "node scripts/codemap.js"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.24.1",
    "@html-eslint/parser": "^0.24.1",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.4"
  }
}
